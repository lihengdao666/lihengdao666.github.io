---
import BaseLayout from "../layouts/BaseLayout.astro";
import { posts } from "../data/posts.js";
---

<BaseLayout>
  <main class="home">
    <h1>h3d4 的个人主页</h1>
    <p class="intro">文章与技术笔记。</p>
    <section class="post-list" aria-label="文章列表">
      {
        posts.map((post) => (
          <a class="post" href={post.href}>
            <strong>{post.title}</strong>
            <span>{post.publishedAt} · {post.description}</span>
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    width: min(840px, calc(100% - 32px));
    margin: 0 auto;
    padding: 56px 0;
  }

  h1 {
    margin: 0 0 12px;
    font-size: clamp(34px, 6vw, 56px);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .intro {
    margin: 0 0 32px;
    color: var(--muted);
    font-size: 17px;
  }

  .post-list {
    display: grid;
    gap: 14px;
  }

  .post {
    display: block;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 20px;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 14px 36px rgba(31, 41, 51, 0.07);
  }

  .post strong {
    display: block;
    margin-bottom: 6px;
    color: var(--accent);
    font-size: 20px;
  }

  .post span {
    color: var(--muted);
  }
</style>
